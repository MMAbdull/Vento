PORT=5000
MONGODB_URI=
# Generate a random secret of at least 32 bytes; never commit the real value.
SESSION_SECRET=
FRONTEND_ORIGINS=http://localhost:5173
NODE_ENV=development
# Optional exact trusted proxy IPs/CIDRs, never a blanket trust setting.
TRUST_PROXY_IPS=
# Keep sensitive dependency debug namespaces disabled.
DEBUG=-express-session,-connect-mongo
